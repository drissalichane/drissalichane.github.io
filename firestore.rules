rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules (project summer-467905), then Publish.
// The site's message form can only add a short message; nobody can read, edit or delete through the site.
// Messages are read in the Firebase console (Firestore Database > Data > guestbook), which these rules do not limit.
// Every other collection is closed (the old tap counter is no longer used).
service cloud.firestore {
  match /databases/{database}/documents {
    match /guestbook/{entryId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (!('email' in request.resource.data) || (request.resource.data.email is string
            && request.resource.data.email.size() <= 120))
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
